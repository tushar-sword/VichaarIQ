# Copy to .env for local development. Never commit real credentials.
NODE_ENV=development

# API
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# OpenAI — used in Phase 2 when agents are implemented
OPENAI_API_KEY=
OPENAI_MODEL=

# VichaarIQ application database (separate from user-connected data sources)
APP_DATABASE_URL=postgresql://vichaar:change_me_local_only@localhost:5432/vichaar_iq

# Optional user database connections are configured per connection in the app.
# Do not put customer database credentials in this shared environment file.
